# 复制为 .env 后填写。所有项都有默认值，只有 API Key 必填。

# ── 工作区（Rhino 文档所在目录，脚本产物都落在这里）────────────────
FACADE_WORKSPACE=D:/moxing

LLM_BASE_URL=https://api.a6api.com/v1
LLM_API_KEY=sk-PtjVrRulR3kkEPQq3IQSZJfKFyRbGJ1Cv28kKNh8PQOgYmB5

MODEL_MAIN=gpt-image-2.5

# 建模子智能体用的模型（负责写几何、迭代修正）—— 这里可以换更强的
MODEL_BUILD=gpt-6.1-sol

# ── Rhino 官方 MCP ────────────────────────────────────────────────
# 传输方式选择：
#   stdio            - 通过命令行启动 MCP 服务（需要安装 rhinomcp）
#   streamable_http  - 连接已运行的 HTTP 服务（推荐，Rhino MCPConnect 启动后使用）
#   sse              - Server-Sent Events 模式
RHINO_MCP_TRANSPORT=streamable_http

# HTTP 模式配置（transport 为 streamable_http 或 sse 时使用）
# 在 Rhino 里执行 MCPConnect 后，会显示类似 "http://localhost:10500/" 的地址
RHINO_MCP_URL=http://localhost:10500/

# stdio 模式配置（transport 为 stdio 时使用）
# RHINO_MCP_COMMAND=uvx
# RHINO_MCP_ARGS=["rhinomcp@latest"]

# 兼容旧配置（可忽略）
RHINO_MCP_HOST=127.0.0.1
RHINO_MCP_PORT=10500

# ── facade MCP（我们自己的工具服务）──────────────────────────────
FACADE_MCP_COMMAND=python
FACADE_MCP_ARGS=["-m","facade_mcp_server"]

# ── 运行参数 ──────────────────────────────────────────────────────
# 建模子图最多迭代几轮（防止无限循环烧钱）
MAX_ATTEMPTS=3
# 覆盖率达标线（测量裁判用）
COVERAGE_TARGET=0.95
# 离线模式：true 时不连 MCP，只读本地文件（用于单测和没有 Rhino 的机器）
FACADE_OFFLINE=false