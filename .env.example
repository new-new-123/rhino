# 复制为 .env 后填写。所有项都有默认值，只有 API Key 必填。

# ── 工作区（Rhino 文档所在目录，脚本产物都落在这里）────────────────
FACADE_WORKSPACE=D:/moxing

# ── 模型（可换：DeepSeek / Claude / GPT 都走 OpenAI 兼容接口）──────
LLM_BASE_URL=https://api.a6api.com/v1
LLM_API_KEY=sk-替换成你的密钥

# 主管图用的模型（负责读图、转译、流程判断）
MODEL_MAIN=gemini-2.5-flash

# 建模子智能体用的模型（负责写几何、迭代修正）—— 这里可以换更强的
MODEL_BUILD=claude-sonnet-4-5

# ── Rhino 官方 MCP ────────────────────────────────────────────────
# 在 Rhino 里执行 MCPConnect 后，用你的 MCP 客户端配置里的命令填这里
RHINO_MCP_COMMAND=uvx
RHINO_MCP_ARGS=["rhinomcp@latest"]
RHINO_MCP_HOST=127.0.0.1
RHINO_MCP_PORT=1999

# ── facade MCP（我们自己的工具服务）──────────────────────────────
FACADE_MCP_COMMAND=python
FACADE_MCP_ARGS=["-m","facade_mcp_server"]

# ── 运行参数 ──────────────────────────────────────────────────────
# 建模子图最多迭代几轮（防止无限循环烧钱）
MAX_ATTEMPTS=3
# 覆盖率达标线（测量裁判用）
COVERAGE_TARGET=0.95
# 离线模式：true 时不连 MCP，只读本地文件（用于单测和没有 Rhino 的机器）
FACADE_OFFLINE=false